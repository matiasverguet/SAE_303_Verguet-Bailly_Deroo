---
interface Props {
  surtitre: string;
  titre: string;
}
const { surtitre, titre } = Astro.props;
---

<header class="relative isolate border-b border-filet py-14 sm:py-20">
  <div class="pointer-events-none absolute -top-24 -left-40 -z-10 size-[36rem] rounded-full bg-cobalt/10 blur-3xl" aria-hidden="true"></div>
  <slot name="avant" />
  <p class="surtitre animate-monte text-cobalt">{surtitre}</p>
  <h1 class="condense mt-3 max-w-4xl animate-monte [animation-delay:120ms] text-5xl leading-[0.92] font-black uppercase sm:text-7xl">{titre}</h1>
  <div class="texte mt-6 max-w-2xl animate-monte text-gris [animation-delay:240ms]">
    <slot />
  </div>
</header>
