---
// Route A : le graphique est calculé au build (jsdom) et livré en SVG statique.
// Aucun JavaScript côté lecteur.
import { JSDOM } from "jsdom";
import Figure from "./Figure.astro";

interface Props {
  id: string;
  numero?: string;
  titre: string;
  sousTitre: string;
  source: string;
  alt: string;
  defilable?: boolean;
  consigne?: string;
  interactif?: boolean;
  barresSurvol?: boolean;
  /** Reçoit le `document` jsdom et renvoie le graphique, ex. (document) => barresCommunes(data, { document }) */
  render: (document: Document) => Element;
}
const { render, ...figure } = Astro.props;
const plot = render(new JSDOM("").window.document);
---

<Figure {...figure} route="A">
  <Fragment set:html={plot.outerHTML} />
</Figure>
